# LifePath 환경변수 예시
# 이 파일을 .env.local로 복사한 뒤 실제 값을 채운다. .env.local은 커밋하지 않는다.

# --- Supabase (필수) ---
# Supabase 대시보드 > Project Settings > API 에서 복사
# 둘 다 클라이언트에 노출되어도 되는 값이다. 실제 보호는 RLS 정책이 담당한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenDART (선택) ---
# 없어도 앱은 mock 회사 데이터로 정상 동작한다.
# 서버 전용. NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다.
DART_API_KEY=
